{
  "name": "Lasertronics Admin & Catalog",
  "short_name": "Lasertronics Admin",
  "description": "Progressive Web App Admin Dashboard for Product, Image, Category and Category-Based Pricing Management",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#0A192F",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "shortcuts": [
    {
      "name": "Manage Products",
      "short_name": "Products",
      "description": "Quick access to product catalog management",
      "url": "/admin?tab=products",
      "icons": [{ "src": "/favicon.png", "sizes": "96x96" }]
    },
    {
      "name": "Pricing Rules",
      "short_name": "Pricing",
      "description": "Configure category markup pricing rules",
      "url": "/admin?tab=pricing",
      "icons": [{ "src": "/favicon.png", "sizes": "96x96" }]
    },
    {
      "name": "Media Library",
      "short_name": "Images",
      "description": "Review and upload product images",
      "url": "/admin?tab=images",
      "icons": [{ "src": "/favicon.png", "sizes": "96x96" }]
    }
  ]
}
